# Google Places API — used for live provider ratings on /compare/
# Set this in Vercel dashboard (Environment Variables) — NEVER commit the real key to git
GOOGLE_PLACES_API_KEY=your_api_key_here

# Cron secret — used to authorise calls to /api/refresh-ratings from Vercel cron
# Generate a random string, set it here and in Vercel dashboard
CRON_SECRET=your_random_secret_here
